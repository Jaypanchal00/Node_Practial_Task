<nav>
  <h1><a href="/">Task Manager</a></h1>
  <ul>
    <% if (user) { %>
      <li>Welcome, <%= user.username %> (<%= user.role %>)</li>
      <li><a href="/tasks">My Tasks</a></li>
      <% if (user.role === 'admin') { %>
        <li><a href="/tasks">All User Tasks</a></li>
      <% } %>
      <li><a href="/tasks/create">Create Task</a></li>
      <li><a href="/logout">Log out</a></li>
    <% } else { %>
      <li><a href="/login">Log in</a></li>
      <li><a href="/signup">Sign up</a></li>
    <% } %>
  </ul>
</nav>

<style>
  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 20px;
    background-color: #eee;
    border-bottom: 1px solid #ddd;
  }
  nav ul {
    display: flex;
    list-style: none;
    align-items: center;
  }
  nav li {
    margin-left: 20px;
  }
  nav a {
    text-decoration: none;
    color: #333;
    font-weight: bold;
  }
</style>
