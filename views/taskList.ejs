<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Tasks</title>
</head>

<body>

    <%- include('partials/navbar'); %>

        <div class="tasks content">
            <h2>All Tasks</h2>
            <% if (tasks.length> 0) { %>
                <% tasks.forEach(task=> { %>
                    <div class="single">
                        <h3 class="title">
                            <%= task.title %>
                        </h3>
                        <p class="status">Status: <%= task.status %>
                        </p>
                        <p class="desc">
                            <%= task.description %>
                        </p>
                        <% if (user.role==='admin' && task.user.username) { %>
                            <p>User: <%= task.user.username %>
                            </p>
                            <% } %>
                                <div class="actions">
                                    <a href="/tasks/edit/<%= task._id %>">Edit</a>
                                    <a class="delete" data-doc="<%= task._id %>">Delete</a>
                                </div>
                    </div>
                    <% }) %>
                        <% } else { %>
                            <p>There are no tasks to display...</p>
                            <% } %>
        </div>

        <script>
            const trashcans = document.querySelectorAll('a.delete');

            trashcans.forEach(el => {
                el.addEventListener('click', (e) => {
                    const endpoint = `/tasks/${el.dataset.doc}`;
                    fetch(endpoint, {
                        method: 'DELETE',
                    })
                        .then(response => response.json())
                        .then(data => window.location.href = data.redirect)
                        .catch(err => console.log(err));
                });
            });
        </script>

        <style>
            .tasks {
                max-width: 600px;
                margin: 40px auto;
            }

            .single {
                padding: 10px;
                border-left: 6px solid #e22d99;
                box-shadow: 1px 2px 3px rgba(0, 0, 0, 0.05);
                margin: 20px 0;
                background: #fff;
            }

            .single h3 {
                margin-bottom: 8px;
            }

            .single p {
                color: #777;
                margin-bottom: 8px;
            }

            .actions {
                margin-top: 10px;
            }

            .actions a {
                cursor: pointer;
                color: #e22d99;
                margin-right: 15px;
                text-decoration: none;
            }

            .actions a.delete {
                color: crimson;
            }
        </style>
</body>

</html>